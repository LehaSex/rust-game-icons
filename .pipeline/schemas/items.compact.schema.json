{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "items.compact.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["category", "id", "image_name", "name"],
    "additionalProperties": false,
    "properties": {
      "category": {"type": "string", "minLength": 1},
      "id": {"type": "integer"},
      "image_name": {"type": "string", "minLength": 1},
      "name": {
        "type": "object",
        "additionalProperties": false,
        "required": ["en", "zh-cn", "ru"],
        "properties": {
          "en": {"type": "string"},
          "zh-cn": {"type": "string"},
          "ru": {"type": "string"}
        }
      }
    }
  }
}